<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="spreadsheet_dashboard.DashboardAction" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-navigation-additional']" position="inside">
            <button t-if="isCashForecastDashboard"
                    class="btn btn-secondary ms-2 o_xpmi_cash_forecast_refresh"
                    t-att-disabled="cashForecast.refreshing"
                    title="Rigenera le previsioni da fatture e ordini e ricarica la pagina"
                    t-on-click="refreshCashForecast">
                <i class="fa fa-refresh me-1" t-att-class="{ 'fa-spin': cashForecast.refreshing }"/>
                <span>Aggiorna</span>
            </button>
        </xpath>
    </t>

</templates>
