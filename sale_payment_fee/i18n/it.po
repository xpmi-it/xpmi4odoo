#. module: sale_payment_fee
#: model:ir.model.fields,field_description:account.payment.term,collection_fee_product_id
msgid "Collection Fee Product"
msgstr "Prodotto Spese di Incasso"

#. module: sale_payment_fee
#: model:ir.model.fields,help:account.payment.term,collection_fee_product_id
msgid ""
"If set, this service product will be automatically added as a line in the "
"sale order when this payment term is selected. The quantity will match the "
"number of installments."
msgstr ""
"Se impostato, questo prodotto di tipo servizio verrà aggiunto automaticamente "
"come riga nell'ordine di vendita quando viene selezionato questo termine di "
"pagamento. La quantità corrisponderà al numero di rate."

#. module: sale_payment_fee
#: model:ir.model.fields,field_description:sale.order.line,is_collection_fee
msgid "Is Collection Fee"
msgstr "È Spesa di Incasso"

#. module: sale_payment_fee
#: model:ir.model.fields,help:sale.order.line,is_collection_fee
msgid "Technical flag: this line was automatically generated as a collection fee."
msgstr "Flag tecnico: questa riga è stata generata automaticamente come spesa di incasso."
